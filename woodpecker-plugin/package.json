{
  "name": "devcontainer-build-run-woodpecker",
  "version": "0.0.0",
  "private": true,
  "description": "Woodpecker CI plugin to use Dev Containers (https://containers.dev) in CI pipelines",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build --prefix ../common && npx tsc -p tsconfig.build.json",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "lint-fix": "eslint --fix src/**/*.ts",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devcontainers/ci.git"
  },
  "keywords": [
    "woodpecker",
    "devcontainer",
    "ci",
    "plugin"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^29.0.1",
    "jest": "^30.2.0",
    "jest-circus": "^30.0.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
