# Woodpecker CI Test Environment Configuration
# Copy this file to .env and fill in your OAuth credentials

# Forgejo OAuth Application Credentials
# Create these in Forgejo: Settings → Applications → Manage OAuth2 Applications
# Redirect URI: http://localhost:8000/authorize
WOODPECKER_GITEA_CLIENT=your-oauth-client-id
WOODPECKER_GITEA_SECRET=your-oauth-client-secret

# Woodpecker Agent Secret
# This secret must match between server and agent
WOODPECKER_AGENT_SECRET=test-secret-123
